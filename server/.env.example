# Copy this file to .env and fill in real values before running the server.

PORT=4001

# Allowed origin(s) for CORS — the URL where the frontend is hosted.
# Comma-separated for multiple origins (e.g. staging + production).
CORS_ORIGIN=http://localhost:5173

# Telegram bot credentials. Create a bot via @BotFather to get a token,
# then add the bot to the target chat/group and find the chat ID
# (e.g. via @getidsbot, or the Telegram Bot API's getUpdates method).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Path to the SQLite database file (created automatically if missing).
DB_PATH=./data/leads.sqlite
