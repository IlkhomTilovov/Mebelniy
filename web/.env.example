# Copy this file to .env and fill in real values before deploying.

# Meta (Facebook) Pixel ID. The site works fine without it — Pixel code
# simply never loads and all trackEvent() calls become no-ops.
VITE_META_PIXEL_ID=

# Backend API base URL. Leave unset in local dev — Vite's dev server proxy
# (see vite.config.js) forwards /api requests to the backend automatically.
# Set this to the deployed backend's URL in production, e.g.:
# VITE_API_BASE_URL=https://api.kitchenstudio.uz/api
VITE_API_BASE_URL=
